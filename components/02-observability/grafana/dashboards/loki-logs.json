{
  "title": "Loki Logs Explorer",
  "uid": "kagenti-loki-logs",
  "tags": ["loki", "logs", "observability"],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 2,
  "refresh": "10s",
  "description": "Loki log explorer with namespace filtering. Note: Logs are ephemeral and reset on Loki pod restart.",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": "Loki",
        "query": "label_values(namespace)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pod",
        "type": "query",
        "label": "Pod",
        "datasource": "Loki",
        "query": "label_values({namespace=~\"$namespace\"}, pod)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "level",
        "type": "custom",
        "label": "Log Level",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "ERROR",
            "value": "error|ERROR|Error",
            "selected": false
          },
          {
            "text": "WARN",
            "value": "warn|WARN|Warning|WARNING",
            "selected": false
          },
          {
            "text": "INFO",
            "value": "info|INFO",
            "selected": false
          },
          {
            "text": "DEBUG",
            "value": "debug|DEBUG",
            "selected": false
          }
        ],
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "Search",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "title": "Total Logs",
      "type": "stat",
      "datasource": "Loki",
      "targets": [{
        "expr": "sum(count_over_time({namespace=~\"$namespace\", pod=~\"$pod\"} |~ \"$search\" |~ \"$level\" [$__range]))",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [{"value": 0, "color": "blue"}]
          }
        }
      }
    },
    {
      "id": 2,
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "title": "Error Count",
      "type": "stat",
      "datasource": "Loki",
      "targets": [{
        "expr": "sum(count_over_time({namespace=~\"$namespace\", pod=~\"$pod\"} |~ \"(?i)(error|ERROR)\" [$__range]))",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "title": "Warning Count",
      "type": "stat",
      "datasource": "Loki",
      "targets": [{
        "expr": "sum(count_over_time({namespace=~\"$namespace\", pod=~\"$pod\"} |~ \"(?i)(warn|WARNING)\" [$__range]))",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "yellow"}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "title": "Logs per Second",
      "type": "stat",
      "datasource": "Loki",
      "targets": [{
        "expr": "sum(rate({namespace=~\"$namespace\", pod=~\"$pod\"} |~ \"$search\" |~ \"$level\" [5m]))",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [{"value": 0, "color": "blue"}]
          },
          "decimals": 2
        }
      }
    },
    {
      "id": 5,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "title": "Log Volume by Level",
      "type": "timeseries",
      "datasource": "Loki",
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({namespace=~\"$namespace\", pod=~\"$pod\"} |~ \"(?i)(error|ERROR)\" [5m]))",
          "refId": "A",
          "legendFormat": "ERROR"
        },
        {
          "expr": "sum by (level) (count_over_time({namespace=~\"$namespace\", pod=~\"$pod\"} |~ \"(?i)(warn|WARNING)\" [5m]))",
          "refId": "B",
          "legendFormat": "WARN"
        },
        {
          "expr": "sum by (level) (count_over_time({namespace=~\"$namespace\", pod=~\"$pod\"} |~ \"(?i)(info|INFO)\" [5m]))",
          "refId": "C",
          "legendFormat": "INFO"
        },
        {
          "expr": "sum by (level) (count_over_time({namespace=~\"$namespace\", pod=~\"$pod\"} |~ \"(?i)(debug|DEBUG)\" [5m]))",
          "refId": "D",
          "legendFormat": "DEBUG"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "barAlignment": 0,
            "fillOpacity": 80,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "ERROR"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
          },
          {
            "matcher": {"id": "byName", "options": "WARN"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]
          },
          {
            "matcher": {"id": "byName", "options": "INFO"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]
          },
          {
            "matcher": {"id": "byName", "options": "DEBUG"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "purple"}}]
          }
        ]
      }
    },
    {
      "id": 6,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
      "title": "Log Volume by Namespace",
      "type": "timeseries",
      "datasource": "Loki",
      "targets": [{
        "expr": "sum by (namespace) (rate({namespace=~\"$namespace\", pod=~\"$pod\"} |~ \"$search\" |~ \"$level\" [5m]))",
        "refId": "A",
        "legendFormat": "{{namespace}}"
      }],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "gradientMode": "opacity"
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 7,
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 20},
      "title": "All Logs",
      "type": "logs",
      "datasource": "Loki",
      "targets": [{
        "expr": "{namespace=~\"$namespace\", pod=~\"$pod\"} |~ \"$search\" |~ \"$level\"",
        "refId": "A"
      }],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 8,
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 32},
      "title": "Error Logs",
      "type": "logs",
      "datasource": "Loki",
      "targets": [{
        "expr": "{namespace=~\"$namespace\", pod=~\"$pod\"} |~ \"(?i)(error|ERROR)\" |~ \"$search\"",
        "refId": "A"
      }],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 9,
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 44},
      "title": "Warning Logs",
      "type": "logs",
      "datasource": "Loki",
      "targets": [{
        "expr": "{namespace=~\"$namespace\", pod=~\"$pod\"} |~ \"(?i)(warn|WARNING)\" |~ \"$search\"",
        "refId": "A"
      }],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 10,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 56},
      "title": "Top 10 Error Sources",
      "type": "table",
      "datasource": "Loki",
      "targets": [{
        "expr": "topk(10, sum by (namespace, pod) (count_over_time({namespace=~\"$namespace\"} |~ \"(?i)(error|ERROR)\" [$__range])))",
        "refId": "A",
        "format": "table",
        "instant": true
      }],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "Value": 2
            },
            "renameByName": {
              "Value": "Error Count"
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 56},
      "title": "Top 10 Warning Sources",
      "type": "table",
      "datasource": "Loki",
      "targets": [{
        "expr": "topk(10, sum by (namespace, pod) (count_over_time({namespace=~\"$namespace\"} |~ \"(?i)(warn|WARNING)\" [$__range])))",
        "refId": "A",
        "format": "table",
        "instant": true
      }],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "Value": 2
            },
            "renameByName": {
              "Value": "Warning Count"
            }
          }
        }
      ]
    }
  ]
}
