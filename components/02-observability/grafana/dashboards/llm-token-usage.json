{
  "dashboard": {
    "title": "LLM Token Usage & Trace Metrics",
    "tags": ["ai", "llm", "tokens", "openinference", "cost"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Token Usage Over Time",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(gen_ai_client_token_usage_total[5m])",
            "legendFormat": "{{service_name}} - {{gen_ai_token_type}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {"drawStyle": "line", "fillOpacity": 10}
          }
        },
        "options": {
          "legend": {"displayMode": "table", "calcs": ["lastNotNull", "mean"]}
        }
      },
      {
        "id": 2,
        "title": "Total Tokens by Service",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum by (service_name) (gen_ai_client_token_usage_total)",
            "legendFormat": "{{service_name}}",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        }
      },
      {
        "id": 3,
        "title": "Token Cost Estimate (USD)",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "sum(gen_ai_client_token_usage_total{gen_ai_token_type='input'}) * 0.00001 + sum(gen_ai_client_token_usage_total{gen_ai_token_type='output'}) * 0.00003",
            "legendFormat": "Estimated Cost",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value",
          "unit": "currencyUSD"
        }
      },
      {
        "id": 4,
        "title": "LLM Call Rate (calls/sec)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "rate(calls_total{openinference_span_kind='LLM'}[5m])",
            "legendFormat": "{{service_name}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "LLM Call Latency (P50, P95, P99)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(duration_milliseconds_bucket{openinference_span_kind='LLM'}[5m])) by (le, service_name))",
            "legendFormat": "P50 - {{service_name}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(duration_milliseconds_bucket{openinference_span_kind='LLM'}[5m])) by (le, service_name))",
            "legendFormat": "P95 - {{service_name}}",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(duration_milliseconds_bucket{openinference_span_kind='LLM'}[5m])) by (le, service_name))",
            "legendFormat": "P99 - {{service_name}}",
            "refId": "C"
          }
        ]
      },
      {
        "id": 6,
        "title": "Trace Volume by Type",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "sum by (openinference_span_kind) (calls_total)",
            "legendFormat": "{{openinference_span_kind}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Agent Activity (CHAIN, AGENT, TOOL)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 16, "x": 8, "y": 16},
        "targets": [
          {
            "expr": "rate(calls_total{openinference_span_kind=~'CHAIN|AGENT|TOOL'}[5m])",
            "legendFormat": "{{openinference_span_kind}} - {{service_name}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "Infrastructure vs Application Traces",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "sum(calls_total{openinference_span_kind=''})",
            "legendFormat": "Infrastructure (Jaeger)",
            "refId": "A"
          },
          {
            "expr": "sum(calls_total{openinference_span_kind!=''})",
            "legendFormat": "Application (Phoenix)",
            "refId": "B"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient"
        }
      },
      {
        "id": 9,
        "title": "Error Rate by Service",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 16, "x": 8, "y": 24},
        "targets": [
          {
            "expr": "rate(calls_total{status_code='STATUS_CODE_ERROR'}[5m])",
            "legendFormat": "{{service_name}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {"drawStyle": "line", "fillOpacity": 10}
          }
        }
      },
      {
        "id": 10,
        "title": "Top Services by Token Usage",
        "type": "table",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "topk(10, sum by (service_name, gen_ai_token_type) (gen_ai_client_token_usage_total))",
            "format": "table",
            "refId": "A"
          }
        ],
        "options": {
          "showHeader": true
        }
      }
    ]
  }
}
