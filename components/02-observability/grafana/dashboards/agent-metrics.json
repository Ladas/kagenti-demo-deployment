      "targets": [{
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "expr": "sum(rate(istio_requests_total{destination_workload_namespace=~\"team.*|agents\",response_code!~\"5.*\"}[5m])) / sum(rate(istio_requests_total{destination_workload_namespace=~\"team.*|agents\"}[5m])) * 100",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 95, "color": "yellow"},
              {"value": 99, "color": "green"}
            ]
          }
        }
      }
    },
