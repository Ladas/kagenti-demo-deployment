{
  "title": "Kubernetes Cluster Overview",
    "uid": "kagenti-k8s-cluster",
    "tags": ["kubernetes", "cluster"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "title": "Cluster CPU Usage",
        "type": "gauge",
        "targets": [{
          "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[5m])) / sum(machine_cpu_cores) * 100",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 70, "color": "yellow"},
                {"value": 90, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
        "title": "Cluster Memory Usage",
        "type": "gauge",
        "targets": [{
          "expr": "sum(container_memory_working_set_bytes{container!=\"\"}) / sum(machine_memory_bytes) * 100",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 70, "color": "yellow"},
                {"value": 90, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "title": "Total Pods",
        "type": "stat",
        "targets": [{
          "expr": "count(kube_pod_info)",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [{"value": 0, "color": "blue"}]
            }
          }
        }
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "title": "Failed Pods",
        "type": "stat",
        "targets": [{
          "expr": "count(kube_pod_status_phase{phase=\"Failed\"})",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8},
        "title": "CPU Usage by Namespace",
        "type": "timeseries",
        "targets": [{
          "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[5m])) by (namespace)",
          "refId": "A",
          "legendFormat": "{{namespace}}"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "cores"
          }
        }
      },
      {
        "id": 6,
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8},
        "title": "Memory Usage by Namespace",
        "type": "timeseries",
        "targets": [{
          "expr": "sum(container_memory_working_set_bytes{container!=\"\"}) by (namespace)",
          "refId": "A",
          "legendFormat": "{{namespace}}"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        }
      },
      {
        "id": 7,
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 17},
        "title": "Pod Status by Namespace",
        "type": "table",
        "targets": [{
          "expr": "sum(kube_pod_status_phase{}) by (namespace, phase)",
          "refId": "A",
          "format": "table",
          "instant": true
        }]
      }
    ]
}
