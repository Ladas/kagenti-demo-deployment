{
  "title": "Kubernetes Cluster Overview",
  "uid": "kagenti-k8s-cluster",
  "tags": ["kubernetes", "cluster", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {"h": 6, "w": 4, "x": 0, "y": 0},
      "title": "Cluster CPU Usage",
      "type": "gauge",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[5m])) / sum(machine_cpu_cores) * 100",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 70, "color": "yellow"},
              {"value": 90, "color": "red"}
            ]
          }
        }
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 2,
      "gridPos": {"h": 6, "w": 4, "x": 4, "y": 0},
      "title": "Cluster Memory Usage",
      "type": "gauge",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "sum(container_memory_working_set_bytes{container!=\"\"}) / sum(machine_memory_bytes) * 100",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 70, "color": "yellow"},
              {"value": 90, "color": "red"}
            ]
          }
        }
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 3,
      "gridPos": {"h": 6, "w": 4, "x": 8, "y": 0},
      "title": "Cluster Disk Usage",
      "type": "gauge",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "(sum(kubelet_volume_stats_used_bytes) / sum(kubelet_volume_stats_capacity_bytes)) * 100",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 70, "color": "yellow"},
              {"value": 90, "color": "red"}
            ]
          }
        }
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 4,
      "gridPos": {"h": 3, "w": 3, "x": 12, "y": 0},
      "title": "Total Pods",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "count(kube_pod_info)",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [{"value": 0, "color": "blue"}]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 5,
      "gridPos": {"h": 3, "w": 3, "x": 15, "y": 0},
      "title": "Running Pods",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "sum(kube_pod_status_phase{phase=\"Running\"}) or vector(0)",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [{"value": 0, "color": "green"}]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 6,
      "gridPos": {"h": 3, "w": 3, "x": 18, "y": 0},
      "title": "Pending Pods",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "sum(kube_pod_status_phase{phase=\"Pending\"}) or vector(0)",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 5, "color": "orange"}
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 7,
      "gridPos": {"h": 3, "w": 3, "x": 21, "y": 0},
      "title": "Failed Pods",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "sum(kube_pod_status_phase{phase=\"Failed\"}) or vector(0)",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "red"}
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 8,
      "gridPos": {"h": 3, "w": 3, "x": 12, "y": 3},
      "title": "Pod Restarts (Last 1h)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "sum(increase(kube_pod_container_status_restarts_total[1h])) or vector(0)",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 10, "color": "red"}
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 9,
      "gridPos": {"h": 3, "w": 3, "x": 15, "y": 3},
      "title": "OOMKilled Pods",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "sum(kube_pod_container_status_terminated_reason{reason=\"OOMKilled\"}) or vector(0)",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "red"}
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 10,
      "gridPos": {"h": 3, "w": 3, "x": 18, "y": 3},
      "title": "CrashLoopBackOff Pods",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "count(kube_pod_container_status_waiting_reason{reason=\"CrashLoopBackOff\"}) or vector(0)",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "red"}
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 11,
      "gridPos": {"h": 3, "w": 3, "x": 21, "y": 3},
      "title": "Firing Alerts",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "orange"},
              {"value": 5, "color": "red"}
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 12,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "title": "Pod Status Over Time",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Running\"})",
          "refId": "A",
          "legendFormat": "Running"
        },
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Pending\"})",
          "refId": "B",
          "legendFormat": "Pending"
        },
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Failed\"})",
          "refId": "C",
          "legendFormat": "Failed"
        },
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Succeeded\"})",
          "refId": "D",
          "legendFormat": "Succeeded"
        },
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Unknown\"})",
          "refId": "E",
          "legendFormat": "Unknown"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "stacking": {"mode": "none"}
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Running"},
            "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Pending"},
            "properties": [{"id": "color", "value": {"fixedColor": "yellow", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Failed"},
            "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Succeeded"},
            "properties": [{"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Unknown"},
            "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": ["last", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 13,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 6},
      "title": "Pod Status by Namespace",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Running\"}) by (namespace)",
          "refId": "A",
          "legendFormat": "{{namespace}} - Running"
        },
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Pending\"}) by (namespace)",
          "refId": "B",
          "legendFormat": "{{namespace}} - Pending"
        },
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Failed\"}) by (namespace)",
          "refId": "C",
          "legendFormat": "{{namespace}} - Failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 0,
            "stacking": {"mode": "none"}
          }
        }
      },
      "options": {
        "legend": {
          "calcs": ["last", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 14,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 15},
      "title": "Total CPU Usage Over Time",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[5m]))",
        "refId": "A",
        "legendFormat": "Total CPU Cores"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 30,
            "gradientMode": "opacity"
          }
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 15,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 15},
      "title": "Total Memory Usage Over Time",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "sum(container_memory_working_set_bytes{container!=\"\"})",
        "refId": "A",
        "legendFormat": "Total Memory"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 30,
            "gradientMode": "opacity"
          }
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 16,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 24},
      "title": "CPU Usage by Namespace",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[5m])) by (namespace)",
        "refId": "A",
        "legendFormat": "{{namespace}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "stacking": {"mode": "none"}
          }
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "last"],
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 17,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 24},
      "title": "Memory Usage by Namespace",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "sum(container_memory_working_set_bytes{container!=\"\"}) by (namespace)",
        "refId": "A",
        "legendFormat": "{{namespace}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "stacking": {"mode": "none"}
          }
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "last"],
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 18,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 33},
      "title": "Total Disk Usage Over Time",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "sum(kubelet_volume_stats_used_bytes)",
          "refId": "A",
          "legendFormat": "Used"
        },
        {
          "expr": "sum(kubelet_volume_stats_capacity_bytes)",
          "refId": "B",
          "legendFormat": "Capacity"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Used"},
            "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Capacity"},
            "properties": [{"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "last"],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 19,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 33},
      "title": "Disk Usage by Namespace",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "sum(kubelet_volume_stats_used_bytes) by (namespace)",
        "refId": "A",
        "legendFormat": "{{namespace}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "last"],
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 20,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 42},
      "title": "Pod Restarts by Namespace",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "sum(rate(kube_pod_container_status_restarts_total[5m])) by (namespace)",
        "refId": "A",
        "legendFormat": "{{namespace}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "last"],
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 21,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 42},
      "title": "Network I/O by Namespace",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{container!=\"\"}[5m])) by (namespace)",
          "refId": "A",
          "legendFormat": "{{namespace}} - RX"
        },
        {
          "expr": "sum(rate(container_network_transmit_bytes_total{container!=\"\"}[5m])) by (namespace)",
          "refId": "B",
          "legendFormat": "{{namespace}} - TX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "last"],
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 22,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 51},
      "title": "Detailed Pod Status by Namespace (Table)",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "sum(kube_pod_status_phase) by (namespace, phase)",
        "refId": "A",
        "format": "table",
        "instant": true
      }],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true},
            "indexByName": {},
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Value"},
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {"value": 0, "color": "transparent"},
                    {"value": 1, "color": "green"}
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{"desc": false, "displayName": "namespace"}]
      }
    },
    {
      "id": 23,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 59},
      "title": "Firing Alerts by Severity",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "ALERTS{alertstate=\"firing\"}",
        "refId": "A",
        "format": "table",
        "instant": true
      }],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "alertstate": true,
              "__name__": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "severity"},
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  {"type": "value", "options": {"critical": {"color": "red", "text": "CRITICAL"}}},
                  {"type": "value", "options": {"warning": {"color": "yellow", "text": "WARNING"}}},
                  {"type": "value", "options": {"info": {"color": "blue", "text": "INFO"}}}
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "severity"}]
      }
    }
  ]
}
