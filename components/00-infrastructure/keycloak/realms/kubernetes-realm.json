      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://prometheus.localtest.me:9443/oauth2/callback",
        "https://prometheus.localtest.me:9443/*"
      ],
      "webOrigins": [
