      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://kiali.localtest.me:9443/oauth2/callback",
        "https://kiali.localtest.me:9443/*"
      ],
      "webOrigins": [
        "https://kiali.localtest.me:9443"
      ]
    }
  ]
}
